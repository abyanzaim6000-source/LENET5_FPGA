# Vitis HLS / Vivado generated project directories, wherever they land in
# the repo (hls/, Lenet5_fpga_top/, or anywhere else a project gets created).
# Matches by substring, not just a "_proj" suffix, since project names
# haven't always been consistent (e.g. "pool_proj_s1" vs "pool_s4_proj").
**/*proj*/

venv/
_pycache_/
*.pyc
.DS_Store
weights/

# Vivado generated files
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.sim/
*.runs/
*.jou
*.log
.Xil/

# Nested duplicate clone / HLS temp
LENET5_FPGA/
Lenet5_fpga_top/*.xpr.lock
